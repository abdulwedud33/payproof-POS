# Placeholders only. Real values live in your environment or a secrets manager. Never commit real values.

# Database (API runtime role: NOBYPASSRLS)
DATABASE_URL=postgres://app_api:CHANGE_ME@localhost:5432/payproof
# Migrations only (table owner role)
MIGRATOR_DATABASE_URL=postgres://migrator:CHANGE_ME@localhost:5432/payproof

REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=CHANGE_ME_LONG_RANDOM
JWT_REFRESH_SECRET=CHANGE_ME_LONG_RANDOM
ACCOUNT_ENCRYPTION_KEY=CHANGE_ME_32_BYTES_BASE64

# Service to service
VERIFICATION_SERVICE_URL=http://localhost:8001
VERIFICATION_SERVICE_TOKEN=CHANGE_ME

# Provider allowlist seed (confirm real hosts in Milestone 0)
PROVIDER_HOST_ALLOWLIST_SEED=

# Retention
RECEIPT_RETENTION_DAYS=30

# Public values only, safe to ship in apps
PUBLIC_API_BASE_URL=http://localhost:3000
